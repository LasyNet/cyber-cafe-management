APP_NAME=Cyber Café API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cyber_cafe
CORS_ORIGINS=http://localhost:5173
